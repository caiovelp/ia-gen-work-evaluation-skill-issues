diff --git a/app/models/research_line.rb b/app/models/research_line.rb
new file mode 100644
index 00000000..edfff7bd
--- /dev/null
+++ b/app/models/research_line.rb
@@ -0,0 +1,23 @@
+# Copyright (c) Universidade Federal Fluminense (UFF).
+# This file is part of SAPOS. Please, consult the license terms in the LICENSE file.
+
+# frozen_string_literal: true
+
+# Represents a ResearchLine, which belongs to a ResearchArea
+class ResearchLine < ApplicationRecord
+  has_paper_trail
+
+  belongs_to :research_area, optional: false
+  has_many :enrollments, dependent: :restrict_with_exception
+
+  validates :research_area, presence: true
+  validates :name, presence: true, uniqueness: { scope: :research_area_id }
+
+  def to_label
+    "#{name}"
+  end
+
+  def full_name
+    "#{name}, #{research_area.name}"
+  end
+end
