diff --git a/app/models/ability.rb b/app/models/ability.rb
index b776311e..954dd50c 100644
--- a/app/models/ability.rb
+++ b/app/models/ability.rb
@@ -262,13 +262,15 @@ class Ability
     if roles[Role::ROLE_ALUNO]
       can :assertion_pdf, Assertion
       can :generate_assertion, Assertion do |assertion, matricula_aluno|
-        assertion.student_can_generate && matricula_aluno.in?(user.student.enrollments.pluck(:enrollment_number))
+        assertion.student_can_generate &&
+          matricula_aluno.in?(user.student.enrollments.pluck(:enrollment_number)) &&
+          !Ability.avulso_enrollment_number?(matricula_aluno)
       end
     end
     if roles[Role::ROLE_PROFESSOR]
       can :assertion_pdf, Assertion
-      can :generate_assertion, Assertion do |assertion|
-        assertion.student_can_generate
+      can :generate_assertion, Assertion do |assertion, matricula_aluno|
+        assertion.student_can_generate && !Ability.avulso_enrollment_number?(matricula_aluno)
       end
     end
     cannot [:destroy, :update, :create], NotificationLog
@@ -304,5 +306,19 @@ class Ability
     else
       cannot [:show, :enroll, :save_enroll], :student_enrollment
     end
+
+    # Only managers may issue documents for "avulso" students
+    unless roles[:manager]
+      cannot [:academic_transcript_pdf, :grades_report_pdf], Enrollment do |enrollment|
+        enrollment.avulso?
+      end
+    end
+  end
+
+  def self.avulso_enrollment_number?(enrollment_number)
+    return false if enrollment_number.blank?
+    Enrollment.joins(:enrollment_status)
+      .where(enrollment_number: enrollment_number, enrollment_statuses: { name: Enrollment::AVULSO_STATUS_NAME })
+      .exists?
   end
 end
