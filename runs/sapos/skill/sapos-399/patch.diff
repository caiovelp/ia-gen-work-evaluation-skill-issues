@@ -149,4 +202,30 @@ class CourseClassesController < ApplicationController
         .delete(:enrollment)
     rescue
     end
+
+  private
+
+  def summary_spreadsheet_data(course_class)
+    t = ->(key) { I18n.t("pdf_content.course_class.summary.#{key}") }
+    has_score = course_class.course.course_type.has_score
+    header = [t.call("sequential_number"), t.call("enrollment_number"),
+      t.call("student_name")]
+    header << t.call("final_grade") if has_score
+    header.concat([t.call("attendance"), t.call("situation"), t.call("obs")])
+
+    class_enrollments = course_class.class_enrollments
+      .joins({ enrollment: :student })
+      .order("students.name")
+    rows = class_enrollments.each_with_index.map do |ce, i|
+      row = [i + 1, ce.enrollment.enrollment_number,
+        ce.enrollment.student.name +
+          (ce.enrollment.has_active_scholarship_now? ? " *" : "")]
+      row << (ce.grade ? (ce.grade / 10.0).round(2) : nil) if has_score
+      row << ce.attendance_to_label
+      row << (ce.situation == ClassEnrollment::REGISTERED ? "" : ce.situation)
+      row << ce.obs
+      row
+    end
+    [header, rows]
+  end
 end
