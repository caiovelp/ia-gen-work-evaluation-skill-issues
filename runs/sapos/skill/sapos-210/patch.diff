diff --git a/app/models/professor_accreditation.rb b/app/models/professor_accreditation.rb
new file mode 100644
index 00000000..8cd5462b
--- /dev/null
+++ b/app/models/professor_accreditation.rb
@@ -0,0 +1,50 @@
+# Copyright (c) Universidade Federal Fluminense (UFF).
+# This file is part of SAPOS. Please, consult the license terms in the LICENSE file.
+
+# frozen_string_literal: true
+
+# A period in which a Professor was accredited (end_date nil = still active)
+class ProfessorAccreditation < ApplicationRecord
+  has_paper_trail
+
+  belongs_to :professor, optional: false
+
+  validates :start_date, presence: true
+  validate :end_date_not_before_start_date
+  validate :single_active_period
+  validate :no_overlap
+
+  scope :active, -> { where(end_date: nil) }
+  scope :chronological, -> { order(:start_date, :id) }
+
+  def active?
+    end_date.nil?
+  end
+
+  def to_label
+    "#{start_date} - #{end_date}"
+  end
+
+  private
+    def siblings
+      ProfessorAccreditation.where(professor_id: professor_id).where.not(id: id)
+    end
+
+    def end_date_not_before_start_date
+      return if start_date.blank? || end_date.blank?
+      errors.add(:end_date, :before_start_date) if end_date < start_date
+    end
+
+    def single_active_period
+      return unless end_date.nil? && siblings.active.exists?
+      errors.add(:base, :already_accredited)
+    end
+
+    def no_overlap
+      return if start_date.blank?
+      last = end_date || Date.new(9999, 12, 31)
+      overlap = siblings.where("start_date <= ?", last)
+        .where("end_date IS NULL OR end_date >= ?", start_date)
+      errors.add(:base, :overlapping_period) if overlap.exists?
+    end
+end
