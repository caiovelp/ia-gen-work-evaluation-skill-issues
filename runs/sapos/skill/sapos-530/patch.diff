+++ b/app/helpers/assertions_pdf_helper.rb
@@ -2,18 +2,30 @@
 
 # app/helpers/assertions_pdf_helper.rb
 module AssertionsPdfHelper  
+  ALIGN_TAG = /<(?:p|div)\s+(?:style="text-align:\s*(left|center|right|justify);?"|align="(left|center|right|justify)")\s*>(.*?)<\/(?:p|div)>/mi
+
+  # Splits the text into [align, text] segments, honoring <p style="text-align: center">
+  def assertion_text_segments(text)
+    segments = []
+    rest = text.to_s
+    while (m = ALIGN_TAG.match(rest))
+      before = m.pre_match
+      segments << [:justify, before] unless before.strip.empty?
+      segments << [(m[1] || m[2]).downcase.to_sym, m[3].strip]
+      rest = m.post_match
+    end
+    segments << [:justify, rest] unless rest.strip.empty?
+    segments
+  end
+
