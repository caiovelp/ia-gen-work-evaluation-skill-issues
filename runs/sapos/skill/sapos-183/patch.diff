   validates_date :thesis_defense_date,
     on_or_after: :admission_date,
@@ -170,6 +171,19 @@ class Enrollment < ApplicationRecord
     end
   end
 
+  def main_advisor_accredited_in_level
+    return if advisements.blank? || level.blank?
+    main = advisements.reject(&:marked_for_destruction?).find(&:main_advisor)
+    return if main.nil? || main.professor.nil?
+    return if AdvisementAuthorization.exists?(
+      professor_id: main.professor.id, level_id: level.id
+    )
+    errors.add(
+      :base, :main_advisor_not_accredited_in_level,
+      professor: main.professor.name, level: level.name
+    )
+  end
+
   def verify_research_area_with_advisors
     return if advisements.blank?
     return if research_area.blank?
