+#!/usr/bin/env python3
+"""Uso: capture.py <rotulo> <arquivo_urls>. Saída em tmp/homologacao/<rotulo>/."""
+import hashlib, os, subprocess, sys, zipfile, re, urllib.request
+
+def fetch(url):
+    req = urllib.request.Request(url)
+    cookie = os.environ.get("HOMOLOGACAO_COOKIE")
+    if cookie:
+        req.add_header("Cookie", cookie)
+    with urllib.request.urlopen(req) as r:
+        return r.read()
+
+def normalize_html(b):
+    s = b.decode("utf-8", "replace")
+    s = re.sub(r'(name="authenticity_token" value=")[^"]*', r'\1X', s)
+    s = re.sub(r'(name="csrf-token" content=")[^"]*', r'\1X', s)
+    s = re.sub(r'-[0-9a-f]{32,64}(\.(css|js|png|svg))', r'\1', s)
+    s = re.sub(r'\d{4}-\d\d-\d\d[ T]\d\d:\d\d:\d\d', 'TS', s)
+    return s
+
+def xlsx_text(b, path):
+    with open(path + ".xlsx", "wb") as f:
+        f.write(b)
+    out = []
+    with zipfile.ZipFile(path + ".xlsx") as z:
+        for n in sorted(z.namelist()):
+            if n.startswith("xl/worksheets/") or n == "xl/sharedStrings.xml":
+                out.append("## " + n)
+                out.append(re.sub(r">\s*<", ">\n<", z.read(n).decode("utf-8", "replace")))
+    return "\n".join(out)
+
+def pdf_text(b, path):
+    with open(path + ".pdf", "wb") as f:
+        f.write(b)
+    return subprocess.run(["pdftotext", "-layout", path + ".pdf", "-"], capture_output=True, text=True, check=True).stdout
+
+def main():
+    label, urls = sys.argv[1], sys.argv[2]
+    outdir = os.path.join("tmp", "homologacao", label)
+    os.makedirs(outdir, exist_ok=True)
+    for line in open(urls, encoding="utf-8"):
+        line = line.strip()
+        if not line or line.startswith("#"):
+            continue
+        kind, url = line.split(None, 1)
+        name = hashlib.sha1(url.encode()).hexdigest()[:12]
+        path = os.path.join(outdir, name)
+        body = fetch(url)
+        if kind == "pdf":
+            text = pdf_text(body, path)
+        elif kind == "xlsx":
+            text = xlsx_text(body, path)
+        else:
+            text = normalize_html(body)
+        with open(path + ".txt", "w", encoding="utf-8") as f:
+            f.write(url + "\n" + text)
+        print(kind, url, "->", path + ".txt")
+
+main()
