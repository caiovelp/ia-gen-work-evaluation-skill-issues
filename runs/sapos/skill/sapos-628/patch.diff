+#!/usr/bin/env python3
+"""Uso: compare.py <rotulo_antes> <rotulo_depois>. Exit 1 se houver diferença."""
+import difflib, os, sys
+
+base = os.path.join("tmp", "homologacao")
+a, b = (os.path.join(base, x) for x in sys.argv[1:3])
+fa = {f for f in os.listdir(a) if f.endswith(".txt")}
+fb = {f for f in os.listdir(b) if f.endswith(".txt")}
+if not fa and not fb:
+    print("Nenhuma captura encontrada; comparador não validou nada.")
+    sys.exit(2)
+diffs = 0
+for f in sorted(fa ^ fb):
+    print("Somente em um dos lados:", f)
+    diffs += 1
+for f in sorted(fa & fb):
+    la = open(os.path.join(a, f), encoding="utf-8").read().splitlines()
+    lb = open(os.path.join(b, f), encoding="utf-8").read().splitlines()
+    d = list(difflib.unified_diff(la, lb, "antes/" + f, "depois/" + f, lineterm=""))
+    if d:
+        diffs += 1
+        print("\n".join(d[:200]))
+print(f"{diffs} diferença(s) em {len(fa | fb)} captura(s).")
+sys.exit(1 if diffs else 0)
