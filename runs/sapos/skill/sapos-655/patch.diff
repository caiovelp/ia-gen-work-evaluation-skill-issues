   private
+    def handle_invalid_authenticity_token(exception)
+      empty_session = session.to_h.except("session_id", "_csrf_token").empty?
+      unless empty_session
+        ExceptionNotifier.notify_exception(
+          exception, env: request.env
+        ) if defined?(ExceptionNotifier)
+      end
+      if request.xhr? || !request.format.html?
+        head :unprocessable_entity
+      else
+        flash[:alert] = I18n.t(
+          "errors.session_expired",
+          default: "Sua sessão expirou. Entre novamente e repita a operação."
+        )
+        redirect_to new_user_session_path
+      end
+    end
