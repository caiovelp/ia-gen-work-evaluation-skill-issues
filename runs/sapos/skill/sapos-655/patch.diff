+      query_params = query_params.to_h.except("data_consulta", :data_consulta)
+      args = @notification.prepare_params_and_derivations(query_params)
+    end
     result = @notification.execute(skip_update: true, override_params: args)
     @messages = result[:notifications]
     @query_sql = result[:query]
