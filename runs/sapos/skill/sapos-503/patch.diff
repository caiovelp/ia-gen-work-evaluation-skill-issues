@@ -0,0 +1,46 @@
+# Copyright (c) Universidade Federal Fluminense (UFF).
+# This file is part of SAPOS. Please, consult the license terms in the LICENSE file.
+
+# frozen_string_literal: true
+
+class ProfessorProjectsController < ApplicationController
+  authorize_resource
+
+  active_scaffold :professor_project do |config|
+    config.list.sorting = { year: "DESC" }
+
+    config.columns[:professor].form_ui = :record_select
+    config.columns[:professor].search_sql = "professors.name"
+    config.columns[:financing_type].form_ui = :select
+    config.columns[:financing_type].options = {
+      options: ProfessorProject::FINANCING_TYPES.map { |t|
+        [I18n.t("activerecord.attributes.professor_project.financing_types.#{t}"), t]
+      },
+      include_blank: false
+    }
+    config.columns[:financing_type].clear_link
+
+    columns = [
+      :professor, :title, :year, :financing_type, :financier, :total_value
+    ]
+    config.create.columns = columns
+    config.update.columns = columns
+    config.list.columns = columns
+    config.show.columns = columns
+    config.search.columns = [:professor, :title, :year]
+
+    config.actions.exclude :deleted_records
+  end
+
+  # Professors (without manager roles) only see and handle their own projects
+  def beginning_of_chain
+    chain = super
+    return chain if current_user.nil? || can?(:manage, ProfessorProject.new)
+
+    chain.where(professor_id: current_user.professor&.id)
+  end
+
+  def before_create_save(record)
+    record.professor ||= current_user&.professor
+  end
+end
