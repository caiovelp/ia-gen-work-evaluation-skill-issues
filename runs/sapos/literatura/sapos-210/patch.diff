diff --git a/app/models/professor_accreditation.rb b/app/models/professor_accreditation.rb
new file mode 100644
index 00000000..43b6e5f1
--- /dev/null
+++ b/app/models/professor_accreditation.rb
@@ -0,0 +1,17 @@
+# frozen_string_literal: true
+
+# Represents one accreditation (credenciamento) of a Professor. A professor may
+# have many, forming the accreditation history.
+class ProfessorAccreditation < ApplicationRecord
+  has_paper_trail
+
+  belongs_to :professor, optional: false
+
+  validates :accreditation_date, presence: true
+  validates :accreditation_date,
+    uniqueness: { scope: :professor_id }, allow_nil: true
+
+  def to_label
+    I18n.l(accreditation_date) if accreditation_date
+  end
+end
