diff --git a/app/models/enrollment.rb b/app/models/enrollment.rb
index 7c32a046..8a6aac65 100644
--- a/app/models/enrollment.rb
+++ b/app/models/enrollment.rb
@@ -216,6 +216,17 @@ class Enrollment < ApplicationRecord
     false
   end
 
+  def avulso?
+    enrollment_status&.name == "Avulso"
+  end
+
+  def self.avulso_number?(enrollment_number)
+    return false if enrollment_number.blank?
+    joins(:enrollment_status)
+      .where(enrollment_number: enrollment_number, enrollment_statuses: { name: "Avulso" })
+      .exists?
+  end
+
   def should_have_user?
     return false unless self.student.can_have_new_user?
     return false unless self.enrollment_status.user
