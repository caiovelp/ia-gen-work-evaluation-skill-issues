+  def enrollment_obs_for_transcript(curr_pdf, options = {})
+    enrollment = options[:enrollment]
+    return if enrollment.obs_for_transcript.blank?
+
+    curr_pdf.group do |pdf|
+      pdf.move_down 10
+      pdf.text(
+        "<b>#{I18n.t('activerecord.attributes.enrollment.obs_for_transcript')}</b>",
+        inline_format: true
+      )
+      pdf.text(enrollment.obs_for_transcript)
+    end
+  end
