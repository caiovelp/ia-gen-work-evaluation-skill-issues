+# Copyright (c) Universidade Federal Fluminense (UFF).
+# This file is part of SAPOS. Please, consult the license terms in the LICENSE file.
+
+# frozen_string_literal: true
+
+class ResearchLinesController < ApplicationController
+  authorize_resource
+
+  active_scaffold :research_line do |config|
+    config.list.sorting = { name: "ASC" }
+    config.create.label = :create_research_line_label
+
+    config.columns = [:name, :code, :research_area]
+    config.list.columns = [:name, :code, :research_area]
+    config.columns[:research_area].form_ui = :select
+    config.columns[:research_area].clear_link
+
+    config.actions.exclude :deleted_records
+  end
+  record_select(
+    per_page: 10,
+    search_on: [:name],
+    order_by: "name",
+    full_text_search: true
+  )
+end
