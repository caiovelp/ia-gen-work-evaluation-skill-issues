+  def self.condition_for_suspended_column(column, value, like_pattern)
+    return if value.blank?
+
+    sql = "scholarship_durations.id IN (
+      SELECT scholarship_suspensions.scholarship_duration_id
+      FROM scholarship_suspensions
+      WHERE scholarship_suspensions.active = ?
+        AND DATE(scholarship_suspensions.start_date) <= DATE(?)
+        AND DATE(scholarship_suspensions.end_date) >= DATE(?)
+    )"
+    case value
+    when "suspended" then ["#{sql}", true, Time.now, Time.now]
+    when "not_suspended" then [sql.sub("IN (", "NOT IN ("), true, Time.now, Time.now]
+    end
+  end
