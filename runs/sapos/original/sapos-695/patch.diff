index 00000000..e28a19ec
--- /dev/null
+++ b/lib/tasks/javascript.rake
@@ -0,0 +1,86 @@
+# Copyright (c) Universidade Federal Fluminense (UFF).
+# This file is part of SAPOS. Please, consult the license terms in the LICENSE file.
+
+# frozen_string_literal: true
+
+# lib/tasks/javascript.rake
+#
+# O node_modules e versionado de proposito (a instalacao nao exige node nem
+# yarn; o Sprockets le a pasta direto). Esta checagem garante que a pasta nao
+# divirja dos manifestos. Nao precisa de node, rede ou banco.
+require "json"
+
+module JavascriptCheck
+  module_function
+
+  # Retorna a lista de erros (vazia se tudo consistente).
+  def erros(raiz = Rails.root)
+    raiz = Pathname.new(raiz)
+    erros = []
+    pkg = JSON.parse(File.read(raiz.join("package.json")))
+    lock = File.read(raiz.join("yarn.lock"))
+    integridade_path = raiz.join("node_modules/.yarn-integrity")
+    integridade = File.exist?(integridade_path) ? JSON.parse(File.read(integridade_path)) : nil
+    if integridade.nil?
+      erros << "node_modules/.yarn-integrity nao existe"
+    end
+
+    (pkg["dependencies"] || {}).merge(pkg["devDependencies"] || {}).each do |nome, faixa|
+      chave = "#{nome}@#{faixa}"
+
+      entrada = lock_entry(lock, chave)
+      if entrada.nil?
+        erros << "yarn.lock nao tem entrada '#{chave}' (package.json declara #{nome} #{faixa})"
+        versao_lock = nil
+      else
+        versao_lock = entrada
+      end
+
+      instalado_path = raiz.join("node_modules", nome, "package.json")
+      versao_instalada = File.exist?(instalado_path) ? JSON.parse(File.read(instalado_path))["version"] : nil
+      if versao_instalada.nil?
+        erros << "node_modules/#{nome}/package.json nao existe"
+      elsif versao_lock && versao_lock != versao_instalada
+        sentido = (Gem::Version.new(versao_lock) > Gem::Version.new(versao_instalada)) ? "lock a frente da pasta" : "pasta a frente do lock"
+        erros << "#{nome}: yarn.lock tem #{versao_lock}, node_modules tem #{versao_instalada} (#{sentido})"
+      end
+
+      if integridade
+        padroes = integridade["topLevelPatterns"] || []
+        unless padroes.include?(chave)
+          erros << "#{nome}: .yarn-integrity registra #{padroes.inspect}, package.json declara '#{chave}'"
+        end
+      end
+    end
+    erros
+  end
+
+  # Versao da entrada do yarn.lock cuja chave inclui o padrao dado.
+  def lock_entry(lock, chave)
+    lock.scan(/^("?[^\s#][^\n]*?"?):\n((?:[ ]{2,}[^\n]*\n)+)/).each do |cabecalho, corpo|
+      chaves = cabecalho.split(",").map { |c| c.strip.delete_prefix('"').delete_suffix('"') }
+      next unless chaves.include?(chave)
+      m = corpo.match(/^\s+version "([^"]+)"/)
+      return m[1] if m
+    end
+    nil
+  end
+end
+
+namespace :javascript do
+  desc "Verifica que node_modules versionado bate com package.json e yarn.lock"
+  task :check do
+    require "pathname"
+    require_relative "../../config/boot" unless defined?(Rails)
+    raiz = Pathname.new(File.expand_path("../..", __dir__))
+    erros = JavascriptCheck.erros(raiz)
+    if erros.empty?
+      puts "node_modules consistente com package.json e yarn.lock"
+    else
+      warn "node_modules divergiu dos manifestos:"
+      erros.each { |e| warn "  - #{e}" }
+      warn "Para sincronizar: yarn install e commite node_modules (veja a skill dependencias)."
+      exit 1
+    end
+  end
+end
