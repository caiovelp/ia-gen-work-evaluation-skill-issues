+  def cancel_class_enrollments
+    first = start_date
+    last = end_date
+    enrollment.class_enrollments
+      .includes(:course_class)
+      .where(situation: ClassEnrollment::REGISTERED)
+      .each do |ce|
+        cc = YearSemester.new(
+          year: ce.course_class.year, semester: ce.course_class.semester
+        )
+        begin_date = cc.semester_begin
+        ce.destroy if begin_date >= first && begin_date <= last
+      end
+  end
+
   def create_phase_completions
     enrollment.create_phase_completions
   end
