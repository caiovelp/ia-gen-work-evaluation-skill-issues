diff --git a/app/models/professor_project.rb b/app/models/professor_project.rb
new file mode 100644
index 00000000..f4796a09
--- /dev/null
+++ b/app/models/professor_project.rb
@@ -0,0 +1,28 @@
+# Copyright (c) Universidade Federal Fluminense (UFF).
+# This file is part of SAPOS. Please, consult the license terms in the LICENSE file.
+
+# frozen_string_literal: true
+
+# Represents a project coordinated by a Professor
+class ProfessorProject < ApplicationRecord
+  has_paper_trail
+
+  PUBLIC = "Público"
+  PRIVATE = "Privado"
+  FINANCING_TYPES = [PUBLIC, PRIVATE].freeze
+
+  belongs_to :professor, optional: false
+
+  validates :professor, presence: true
+  validates :title, presence: true
+  validates :year, presence: true,
+    numericality: { only_integer: true, greater_than: 0 }
+  validates :financing_type, presence: true, inclusion: { in: FINANCING_TYPES }
+  validates :financier, presence: true
+  validates :total_amount, presence: true,
+    numericality: { greater_than_or_equal_to: 0 }
+
+  def to_label
+    "#{self.title} (#{self.year})"
+  end
+end
