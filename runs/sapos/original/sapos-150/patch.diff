+  def self.condition_for_suspended_column(column, value, like_pattern)
+    return if value.blank?
+    subquery = "SELECT scholarship_suspensions.scholarship_duration_id
+      FROM scholarship_suspensions
+      WHERE scholarship_suspensions.active = TRUE
+      AND DATE(scholarship_suspensions.start_date) <= DATE(?)
+      AND DATE(scholarship_suspensions.end_date) >= DATE(?)"
+    case value
+    when "suspended"
+      ["scholarship_durations.id IN (#{subquery})", Time.now, Time.now]
+    when "not_suspended"
+      ["scholarship_durations.id NOT IN (#{subquery})", Time.now, Time.now]
+    end
+  end
