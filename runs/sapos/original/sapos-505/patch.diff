+# Copyright (c) Universidade Federal Fluminense (UFF).
+# This file is part of SAPOS. Please, consult the license terms in the LICENSE file.
+
+# frozen_string_literal: true
+
+class ArticlesController < ApplicationController
+  authorize_resource
+
+  active_scaffold :article do |config|
+    config.create.label = :create_article_label
+    config.columns = [:title, :journal, :year, :qualis, :issn, :doi, :authors, :professor]
+    config.actions.swap :search, :field_search
+    config.columns[:professor].form_ui = :record_select
+    config.columns[:qualis].form_ui = :select
+    config.columns[:qualis].options = {
+      options: Article::QUALIS,
+      include_blank: I18n.t("active_scaffold._select_")
+    }
+    config.columns[:year].options[:format] = "%d"
+    config.actions.exclude :deleted_records
+  end
+
+  protected
+  def do_new
+    super
+    unless current_user.professor.blank?
+      @record.professor = current_user.professor
+    end
+  end
+end
