+  ALIGN_TAGS = { "center" => :center, "justify" => :justify, "left" => :left, "right" => :right }.freeze
+
+  # Splits the body into [alignment, text] segments using <center>, <justify>,
+  # <left> and <right> tags. Text outside any tag has nil alignment (justified).
+  def report_body_segments(body)
+    segments = []
+    pos = 0
+    body.scan(/<(center|justify|left|right)>(.*?)<\/\1>/mi) do |tag, text|
+      m = Regexp.last_match
+      segments << [nil, body[pos...m.begin(0)]] if m.begin(0) > pos
+      segments << [ALIGN_TAGS[tag.downcase], text.strip]
+      pos = m.end(0)
+    end
+    segments << [nil, body[pos..]] if pos < body.length
+    segments
+  end
