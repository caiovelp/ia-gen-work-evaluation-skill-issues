diff --git a/app/models/enrollment.rb b/app/models/enrollment.rb
index 21e6a187..091e05f3 100644
--- a/app/models/enrollment.rb
+++ b/app/models/enrollment.rb
@@ -41,6 +41,7 @@ class Enrollment < ApplicationRecord
   validates :student, presence: true
   validates_associated :dismissal
   validate :enrollment_has_main_advisor
+  validate :enrollment_has_accredited_advisor
 
   validates_date :thesis_defense_date,
     on_or_after: :admission_date,
@@ -170,6 +171,20 @@ class Enrollment < ApplicationRecord
     end
   end
 
+  def enrollment_has_accredited_advisor
+    return if level.blank?
+    advs = advisements.reject(&:marked_for_destruction?)
+    return if advs.blank?
+
+    accredited = advs.any? do |a|
+      next false if a.professor.blank?
+      AdvisementAuthorization.where(
+        professor_id: a.professor.id, level_id: level.id
+      ).exists?
+    end
+    errors.add(:base, :advisor_not_accredited_on_level) unless accredited
+  end
+
   def verify_research_area_with_advisors
     return if advisements.blank?
     return if research_area.blank?
