diff --git a/app/models/admissions/ranking_process.rb b/app/models/admissions/ranking_process.rb
index 711fd789..52a65759 100644
--- a/app/models/admissions/ranking_process.rb
+++ b/app/models/admissions/ranking_process.rb
@@ -36,4 +36,21 @@ class Admissions::RankingProcess < ActiveRecord::Base
     end
     remaining
   end
+
+  # Ties beyond the available vacancies are consumed from the readjust
+  # counters (applied at the end of the step); others consume normally.
+  def decrease_tie_vacancies!(groups, process_vacancies, readjust_groups, readjust_process_vacancies)
+    if process_vacancies[self.id] <= 0
+      readjust_process_vacancies[self.id] -= 1
+    else
+      process_vacancies[self.id] -= 1
+    end
+    if self.group.present? && !groups[self.group].nil?
+      if groups[self.group] <= 0
+        readjust_groups[self.group] -= 1
+      else
+        groups[self.group] -= 1
+      end
+    end
+  end
 end
