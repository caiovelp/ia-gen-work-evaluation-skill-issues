--- /dev/null
+++ b/.claude/skills/homologacao/scripts/compare.sh
@@ -0,0 +1,10 @@
+#!/usr/bin/env bash
+# Uso: compare.sh <rótulo_antes> <rótulo_depois>
+set -uo pipefail
+a=capturas/$1; b=capturas/$2; rc=0
+for f in "$a"/*; do
+  n=$(basename "$f")
+  if [ ! -f "$b/$n" ]; then echo "AUSENTE: $n"; rc=1
+  elif ! cmp -s "$f" "$b/$n"; then echo "DIFERENTE: $n"; rc=1; fi
+done
+exit $rc
