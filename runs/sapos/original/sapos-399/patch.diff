diff --git a/app/views/course_classes/summary_xlsx.xlsx.axlsx b/app/views/course_classes/summary_xlsx.xlsx.axlsx
new file mode 100644
index 00000000..f3c33466
--- /dev/null
+++ b/app/views/course_classes/summary_xlsx.xlsx.axlsx
@@ -0,0 +1,24 @@
+# Copyright (c) Universidade Federal Fluminense (UFF).
+# This file is part of SAPOS. Please, consult the license terms in the LICENSE file.
+
+# frozen_string_literal: true
+
+t = ->(key) { I18n.t("pdf_content.course_class.summary.#{key}") }
+has_score = @course_class.course.course_type.has_score
+wb = xlsx_package.workbook
+wb.add_worksheet(name: t.call("title")) do |sheet|
+  head = [t.call("sequential_number"), t.call("enrollment_number"), t.call("student_name")]
+  head << t.call("final_grade") if has_score
+  head.concat([t.call("attendance"), t.call("situation"), t.call("obs")])
+  sheet.add_row head
+  @course_class.class_enrollments
+    .joins({ enrollment: :student }).order("students.name")
+    .each_with_index do |ce, i|
+    row = [i + 1, ce.enrollment.enrollment_number, ce.enrollment.student.name]
+    row << ce.grade if has_score
+    row << ce.attendance_to_label
+    row << (ce.situation == ClassEnrollment::REGISTERED ? "" : ce.situation)
+    row << ce.obs
+    sheet.add_row row, escape_formulas: true
+  end
+end
