     config.columns[:date].search_sql = "dismissals.date"
@@ -26,4 +37,14 @@ class DismissalsController < ApplicationController
 
     config.actions.exclude :deleted_records
   end
+
+  def self.condition_for_year_column(column, value, like_pattern)
+    return "" if value.blank?
+    year = value.to_i
+    return "1 = 2" if year <= 0
+    [
+      "dismissals.date >= ? AND dismissals.date < ?",
+      Date.new(year, 1, 1), Date.new(year + 1, 1, 1)
+    ]
+  end
 end
