 # This workflow will install a prebuilt Ruby version, install dependencies, and run tests.
 name: "Ruby on Rails CI"
 
-on: [push, pull_request]
+on:
+  push:
+  pull_request:
+  # O audit depende do tempo, nao do codigo: uma CVE nova torna o lock
+  # vulneravel sem push algum. Neste gatilho roda so o job `checks`, e nele
+  # so o Audit.
+  schedule:
+    - cron: "0 6 * * 1"
 
 # No job writes to the repository contents: only checkout, setup and artifact
 # upload. The qlty upload uses secrets.QLTY_COVERAGE_TOKEN; the GitHub coverage
@@ -11,7 +18,53 @@ permissions:
   contents: read
 
 jobs:
+  # Checagens estaticas: nao dependem de navegador nem de banco, entao rodam
+  # uma vez so, em paralelo com `test` e sem `needs` -- encadear atrasaria a
+  # suite e traria de volta um vermelho escondendo o outro. O portao e a branch
+  # protection exigindo os dois status.
+  checks:
+    runs-on: ubuntu-latest
+    env:
+      RAILS_ENV: test
+      BUNDLE_WITHOUT: production
+
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@v5
+
+      - name: Install Ruby and gems
+        uses: ruby/setup-ruby@v1
+        with:
+          bundler-cache: true
+          cache-version: 3
+
+      # O Gemfile nao declara piso de seguranca (">= x.y.z"): piso envelhece
+      # calado. O que garante que o lock nao carrega CVE conhecida e esta
+      # checagem, contra a base de advisories baixada na hora. Unico passo que
+      # roda no gatilho semanal.
+      - name: Audit
+        run: bundle exec bundle-audit check --update
+
+      - name: Lint
+        if: github.event_name != 'schedule'
+        run: bundle exec rubocop
+
+      # Modo relatorio ate o mantenedor triar os avisos existentes; depois, com
+      # um config/brakeman.ignore anotado, remover --no-exit-on-warn para virar
+      # portao, como o rubocop virou na #644.
+      - name: Brakeman
+        if: github.event_name != 'schedule'
+        run: bundle exec brakeman --no-pager --no-exit-on-warn
+
+      # O eager load le colunas pelo active_scaffold, entao precisa de esquema.
+      - name: Zeitwerk
+        if: github.event_name != 'schedule'
+        run: |
+          cp config/database.yml.example config/database.yml
+          bundle exec rake db:schema:load zeitwerk:check
+
   test:
+    if: github.event_name != 'schedule'
     runs-on: ubuntu-latest
 
